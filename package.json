{
  "name": "mars-colony-sim",
  "version": "0.5.0",
  "private": true,
  "description": "Browser-based 2D pixel-art Mars colony simulator — NASA Space Apps Challenge 2026",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "test": "node --test",
    "test:sim": "node --test \"tests/**/*.test.mjs\"",
    "test:sync": "node --test \"tools/git-sync/test/*.test.mjs\"",
    "sync": "node tools/git-sync/sync.mjs",
    "sync:once": "node tools/git-sync/sync.mjs --once",
    "sync:pause": "node tools/git-sync/sync.mjs pause",
    "sync:resume": "node tools/git-sync/sync.mjs resume",
    "sync:status": "node tools/git-sync/sync.mjs status",
    "codex": "node tools/codex/delegate.mjs",
    "assets:prompts": "node tools/assets/build-prompts.mjs",
    "assets:check": "node tools/assets/build-prompts.mjs --check",
    "assets:gen": "node tools/assets/generate.mjs",
    "assets:verify": "node tools/assets/check-image.mjs"
  }
}
